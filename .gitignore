.pnp
.pnp.js

# Next.js
/.next/
/out/
next-env.d.ts

# Produktion
/build/
/dist/

# Tests
/coverage/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Umgebung
.env
.env*.local

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Lighthouse
/.lighthouseci/
/lighthouse-report*

# Pacotes de entrega (git bundle) — não pertencem ao repositório
*.bundle

# Conteúdo escrito no painel de administração.
# Vive no servidor, não no repositório: é a redação que o escreve, e cada
# instalação (produção, pré-produção, o portátil de quem desenvolve) tem o
# seu. A semente versionada está em src/content/data. Quem faz cópias de
# segurança do servidor tem de incluir esta pasta.
/conteudo/

# Fotografias carregadas pelo painel. Mesmo raciocínio: entram pelo servidor,
# não por um commit. As que acompanham o portal (logótipos, molduras de
# espera) estão versionadas e não são apanhadas por estes padrões.
/public/images/**/*.jpg
/public/images/**/*.jpeg
/public/images/**/*.webp
!/public/images/logotipo*.png
